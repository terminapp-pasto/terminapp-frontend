# Copy this file to .env.local to work on your computer.
# On Vercel, the same variables go in Settings → Environment Variables.

# Backend running on your computer (if missing, the page uses the backend on Render)
VITE_API_URL=http://127.0.0.1:8001

# Stripe PUBLISHABLE test key (starts with pk_test_). It is safe in the browser;
# the secret key (sk_test_) lives only in the backend.
VITE_STRIPE_PUBLISHABLE_KEY=

# Test account shown on the login screen (optional, same as the backend's)
VITE_TEST_ACCOUNT_EMAIL=
VITE_TEST_ACCOUNT_PASSWORD=
