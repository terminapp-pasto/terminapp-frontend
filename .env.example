# Copia este archivo como .env.local para trabajar en tu computador.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Backend en tu computador (si no se pone, la página usa el backend publicado en Render)
VITE_API_URL=http://127.0.0.1:8001

# Clave PUBLICABLE de Stripe en modo prueba (empieza con pk_test_). Esta sí puede
# estar en el navegador; la clave secreta (sk_test_) va solo en el backend.
VITE_STRIPE_PUBLISHABLE_KEY=

# Cuenta de prueba que se muestra en "Ingresar" (opcional, la misma del backend)
VITE_TEST_ACCOUNT_EMAIL=
VITE_TEST_ACCOUNT_PASSWORD=
